{
  "info": {
    "_postman_id": "8e962e55-5bf2-4a13-96b1-3f315d7f4e77",
    "name": "Anegudde Token APIs",
    "description": "Token create and token details APIs for desktop integration.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create Token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{auth_token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"token_count\": 10\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/tokens/create_token",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "tokens",
            "create_token"
          ]
        },
        "description": "Creates token batch for active financial year."
      },
      "response": []
    },
    {
      "name": "Get Token Details By Date",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{auth_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/tokens/get_details_by_date/{{target_date}}?page={{page}}&page_size={{page_size}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "tokens",
            "get_details_by_date",
            "{{target_date}}"
          ],
          "query": [
            {
              "key": "page",
              "value": "{{page}}"
            },
            {
              "key": "page_size",
              "value": "{{page_size}}"
            }
          ]
        },
        "description": "Returns paginated token details for the date."
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:2403"
    },
    {
      "key": "auth_token",
      "value": ""
    },
    {
      "key": "target_date",
      "value": "2026-05-08"
    },
    {
      "key": "page",
      "value": "1"
    },
    {
      "key": "page_size",
      "value": "20"
    }
  ]
}
